	partition DimEmployee = m
		mode: import
		source =
				let
				    Źródło = Csv.Document(File.Contents("C:\Users\erozm\Downloads\case-study-hr-analytics-in-power-bi\Datasets\Employee.csv"),[Delimiter=",", Columns=23, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Nagłówki o podwyższonym poziomie" = Table.PromoteHeaders(Źródło, [PromoteAllScalars=true]),
				    #"Zmieniono typ" = Table.TransformColumnTypes(#"Nagłówki o podwyższonym poziomie",{{"EmployeeID", type text}, {"FirstName", type text}, {"LastName", type text}, {"Gender", type text}, {"Age", Int64.Type}, {"BusinessTravel", type text}, {"Department", type text}, {"DistanceFromHome (KM)", Int64.Type}, {"State", type text}, {"Ethnicity", type text}, {"Education", Int64.Type}, {"EducationField", type text}, {"JobRole", type text}, {"MaritalStatus", type text}, {"Salary", Int64.Type}, {"StockOptionLevel", Int64.Type}, {"OverTime", type text}, {"HireDate", type date}, {"Attrition", type text}, {"YearsAtCompany", Int64.Type}, {"YearsInMostRecentRole", Int64.Type}, {"YearsSinceLastPromotion", Int64.Type}, {"YearsWithCurrManager", Int64.Type}}),
				    #"Zmieniono typ z ustawieniami regionalnymi" = Table.TransformColumnTypes(#"Zmieniono typ", {{"HireDate", type date}}, "en-US"),
				    #"Dodano kolumnę warunkową" = Table.AddColumn(#"Zmieniono typ z ustawieniami regionalnymi", "AgeBins", each if [Age] >= 50 then "50>" else if [Age] >= 40 then "40-49" else if [Age] >= 30 then "30-39" else if [Age] >= 20 then "20-29" else "<20"),
				    #"Dodano kolumnę niestandardową" = Table.AddColumn(#"Dodano kolumnę warunkową", "AgeBinsSorted", each if [Age] >= 50 then 5 else if [Age] >= 40 then 4 else if [Age] >= 30 then 3 else if [Age] >= 20 then 2 else 1),
				    #"Zmieniono typ1" = Table.TransformColumnTypes(#"Dodano kolumnę niestandardową",{{"AgeBinsSorted", Int64.Type}})
				in
				    #"Zmieniono typ1"

	annotation PBI_NavigationStepName = Nawigacja

